---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import cars from '../../data/cars.json';
---

<Layout title="Compare EVs Side-by-Side - EVScout">
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <h1>Compare EVs <span class="highlight">Side-by-Side</span></h1>
      <p>Select two electric vehicles to compare every spec.</p>
    </div>
  </section>

  <section class="container compare-section">
    <div class="selectors">
      <div class="selector">
        <label>Vehicle 1</label>
        <select id="car1Select">
          <option value="">-- Select an EV --</option>
          {cars.map(car => (
            <option value={car.id}>{car.brand} {car.model} ({car.year})</option>
          ))}
        </select>
      </div>
      <div class="vs">VS</div>
      <div class="selector">
        <label>Vehicle 2</label>
        <select id="car2Select">
          <option value="">-- Select an EV --</option>
          {cars.map(car => (
            <option value={car.id}>{car.brand} {car.model} ({car.year})</option>
          ))}
        </select>
      </div>
    </div>

    <div id="compareResult" class="compare-result" style="display:none;">
      <div class="compare-header">
        <div class="compare-car" id="car1Header"></div>
        <div class="compare-car" id="car2Header"></div>
      </div>
      <div class="compare-table" id="compareTable"></div>
    </div>

    <div id="emptyState" class="empty-state">
      <p>Select two vehicles above to see a detailed comparison.</p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script define:vars={{ cars }}>
  const car1Select = document.getElementById('car1Select');
  const car2Select = document.getElementById('car2Select');
  const result = document.getElementById('compareResult');
  const empty = document.getElementById('emptyState');
  const car1Header = document.getElementById('car1Header');
  const car2Header = document.getElementById('car2Header');
  const table = document.getElementById('compareTable');

  const specs = [
    { key: 'priceUSD', label: 'Price (MSRP)', format: v => '$' + v.toLocaleString('en-US'), better: 'lower' },
    { key: 'rangeMiles', label: 'Range', format: v => v + ' miles', better: 'higher' },
    { key: 'rangeKm', label: 'Range (km)', format: v => v + ' km', better: 'higher' },
    { key: 'batteryKWh', label: 'Battery', format: v => v + ' kWh', better: 'higher' },
    { key: 'chargingTimeHrs', label: 'Charging Time (L2)', format: v => v + ' hours', better: 'lower' },
    { key: 'fastChargeMins', label: 'DC Fast Charge', format: v => v + ' min', better: 'lower' },
    { key: 'acceleration060', label: '0-60 mph', format: v => v + 's', better: 'lower' },
    { key: 'topSpeedMph', label: 'Top Speed', format: v => v + ' mph', better: 'higher' },
    { key: 'horsePower', label: 'Horsepower', format: v => v + ' hp', better: 'higher' },
    { key: 'torqueNm', label: 'Torque', format: v => v + ' Nm', better: 'higher' },
    { key: 'driveType', label: 'Drive Type', format: v => v, better: null },
    { key: 'seats', label: 'Seats', format: v => v, better: null },
    { key: 'cargoLiters', label: 'Cargo Space', format: v => v + ' L', better: 'higher' },
    { key: 'weight', label: 'Weight', format: v => v + ' kg', better: 'lower' },
    { key: 'warranty', label: 'Vehicle Warranty', format: v => v, better: null },
    { key: 'batteryWarranty', label: 'Battery Warranty', format: v => v, better: null },
    { key: 'rating', label: 'Rating', format: v => v + ' / 5.0', better: 'higher' },
  ];

  function renderComparison() {
    const id1 = car1Select.value;
    const id2 = car2Select.value;

    if (!id1 || !id2) {
      result.style.display = 'none';
      empty.style.display = '';
      return;
    }

    const c1 = cars.find(c => c.id === id1);
    const c2 = cars.find(c => c.id === id2);

    car1Header.innerHTML = `
      <img src="${c1.image}" alt="${c1.brand} ${c1.model}" />
      <h3>${c1.brand} ${c1.model}</h3>
      <p>${c1.year} · ${c1.category}</p>
    `;
    car2Header.innerHTML = `
      <img src="${c2.image}" alt="${c2.brand} ${c2.model}" />
      <h3>${c2.brand} ${c2.model}</h3>
      <p>${c2.year} · ${c2.category}</p>
    `;

    let html = '';
    specs.forEach(spec => {
      const v1 = c1[spec.key];
      const v2 = c2[spec.key];
      let class1 = '', class2 = '';

      if (spec.better && typeof v1 === 'number' && typeof v2 === 'number') {
        if (spec.better === 'higher') {
          if (v1 > v2) class1 = 'winner';
          else if (v2 > v1) class2 = 'winner';
        } else {
          if (v1 < v2) class1 = 'winner';
          else if (v2 < v1) class2 = 'winner';
        }
      }

      html += `
        <div class="compare-row">
          <span class="compare-val ${class1}">${spec.format(v1)}</span>
          <span class="compare-label">${spec.label}</span>
          <span class="compare-val ${class2}">${spec.format(v2)}</span>
        </div>
      `;
    });

    table.innerHTML = html;
    result.style.display = '';
    empty.style.display = 'none';
  }

  car1Select.addEventListener('change', renderComparison);
  car2Select.addEventListener('change', renderComparison);
</script>

<style>
  .page-hero {
    padding: 40px 0 30px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 8px; }
  .highlight { color: var(--accent); }
  .page-hero p { color: var(--text-secondary); font-size: 1.05rem; }

  .compare-section { padding: 40px 0 0; }

  .selectors {
    display: flex;
    align-items: end;
    gap: 20px;
    justify-content: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .selector {
    flex: 1;
    max-width: 350px;
  }

  .selector label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .selector select {
    width: 100%;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .selector select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .vs {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--accent);
    padding-bottom: 6px;
  }

  .compare-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  :global(.compare-car) {
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }

  :global(.compare-car img) {
    width: 100%;
    border-radius: 10px;
    margin-bottom: 12px;
    aspect-ratio: 3/2;
    object-fit: cover;
  }

  :global(.compare-car h3) {
    font-size: 1.15rem;
    font-weight: 700;
  }

  :global(.compare-car p) {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-transform: capitalize;
  }

  :global(.compare-row) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    align-items: center;
  }

  :global(.compare-row:last-child) { border-bottom: none; }

  :global(.compare-val) {
    font-size: 0.95rem;
    font-weight: 600;
  }

  :global(.compare-val:first-child) { text-align: right; }
  :global(.compare-val:last-child) { text-align: left; }

  :global(.compare-val.winner) {
    color: var(--accent);
    font-weight: 800;
  }

  :global(.compare-label) {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 500;
    min-width: 140px;
  }

  .compare-table {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .empty-state {
    text-align: center;
    padding: 60px 0;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    h1 { font-size: 1.8rem; }
    .selectors { flex-direction: column; align-items: stretch; }
    .selector { max-width: 100%; }
    .vs { text-align: center; }
    .compare-header { grid-template-columns: 1fr; }
    :global(.compare-label) { min-width: 80px; font-size: 0.7rem; }
    :global(.compare-val) { font-size: 0.8rem; }
  }
</style>
